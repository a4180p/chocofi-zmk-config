#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT_L 0
#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

&mt { quick-tap-ms = <100>; };

/ {
    chosen { zmk,matrix_transform = &five_column_transform; };

    combos {
        compatible = "zmk,combos";

        macro_esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            timeout-ms = <50>;
        };

        layout {
            bindings = <&kp LC(BACKSLASH)>;
            key-positions = <13 16>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
  &kp Q        &kp W  &kp E         &kp R         &kp T          &kp Y      &kp U               &kp I               &kp O       &kp P
  &mt LCTRL A  &kp S  &kp D         &kp F         &kp G          &kp H      &kp J               &kp K               &kp L       &mt LCTRL SEMICOLON
  &mt LSHFT Z  &kp X  &kp C         &kp V         &kp B          &kp N      &kp M               &kp COMMA           &kp PERIOD  &mt RSHFT SLASH
                      &mt LALT TAB  &mt LGUI TAB  &lt 1 SPACE    &lt 2 RET  &mt RGUI BACKSPACE  &mt LALT BACKSPACE
            >;
        };

        nav_layer {
            label = "num";
            bindings = <
  &kp ESC    &trans     &kp UP        &kp EQUAL      &kp LBRC                &kp RBRC  &kp KP_N7        &kp KP_N8        &kp KP_N9  &kp KP_PLUS
  &kp LSHFT  &kp LEFT   &kp DOWN      &kp RIGHT      &kp LBKT                &kp RBKT  &kp KP_N4        &kp KP_N5        &kp KP_N6  &kp MINUS
  &kp DEL    &kp PG_UP  &kp CAPSLOCK  &kp PAGE_DOWN  &kp LEFT_PARENTHESIS    &kp RPAR  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_N3  &kp KP_MULTIPLY
                        &trans        &trans         &trans                  &mo 3     &kp KP_NUMBER_0  &trans
            >;
        };

        sim_layer {
            label = "SYM";
            bindings = <
  &kp EXCL  &kp AT  &kp HASH   &kp DLLR  &kp PRCNT    &kp CARET     &kp AMPS      &kp GRAVE   &kp SQT     &kp DQT
  &trans    &trans  &kp RA(S)  &trans    &trans       &kp C_MUTE    &trans        &trans      &trans      &trans
  &trans    &trans  &trans     &trans    &trans       &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PREV  &kp C_NEXT  &kp BSLH
                    &trans     &trans    &mo 3        &trans        &kp C_PP      &trans
            >;
        };

        adjust_layer {
            label = "ADJ";
            bindings = <
  &sys_reset   &bt BT_CLR  &out OUT_TOG  &trans  &trans    &trans  &kp F7  &kp F8  &kp F9  &kp F12
  &bootloader  &bt BT_NXT  &trans        &trans  &trans    &trans  &kp F4  &kp F5  &kp F6  &kp F11
  &trans       &bt BT_PRV  &trans        &trans  &trans    &trans  &kp F1  &kp F2  &kp F3  &kp F10
                           &trans        &none   &trans    &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                  &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
